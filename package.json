{
  "name": "librepaq",
  "private": true,
  "version": "0.1.0",
  "description": "LibrePaq Pro - Sistema Contable y Fiscal Inteligente en la Nube con Facturación Electrónica SAT Anexo 24",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vite build",
    "preview": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true bun --bun vite preview --port 3000",
    "start": "bun run server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "deploy:hosting": "firebase deploy --only hosting",
    "build:deploy": "bun run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.1",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1"
  }
}
